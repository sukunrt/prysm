  {
   "type": "timeseries",
   "title": "FFG vote seats received per slot, per node",
   "id": 1,
   "datasource": {
    "type": "prometheus",
    "uid": "shadow-sim"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 5
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ffg_vote_seats",
     "legendFormat": "{{instance}}"
    },
    {
     "refId": "B",
     "expr": "max(ffg_expected_seats)",
     "legendFormat": "expected"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "FFG seat fraction per node",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "shadow-sim"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 5
     },
     "unit": "percentunit",
     "max": 1,
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ffg_vote_seats / ffg_expected_seats",
     "legendFormat": "{{instance}}"
    }
   ]
  },
