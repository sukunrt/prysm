# Patched ethpandaops/ethereum-genesis-generator for the decoupled fork.
#
# Mirrors decoupled-shadow-sim/Dockerfile.genesis-gen, plus the CL genesis
# state itself (kurtosis has no equivalent of that repo's post-hoc
# make-heze-genesis.sh, so the swap happens inside the image).
#
# Everything else the fork needs is already reachable from
# network_params.yaml: gloas_fork_epoch / heze_fork_epoch = 0, a single-entry
# BLOB_SCHEDULE from bpo_1_*, and Amsterdam at the EL genesis time as a
# consequence of gloas_fork_epoch 0.
#
# The patches live in patch-generator.sh; read that first.

# ethereum-package >= the buildoor-instances schema runs
# /apps/validator-mapping/merge.sh out of the genesis-generator image to turn
# the per-participant key ranges into the validator-ranges file it hands each
# buildoor. 6.0.2 predates that script, and the run aborts with exit 127
# before any node starts. Take the script from a generator that has it rather
# than rebasing off 6.0.2, whose CL config template is what carries the fork's
# patches. It is a pure jq/yq/sed script and 6.0.2 has all three.
FROM ethpandaops/ethereum-genesis-generator:6.2.0 AS egg-newer

FROM ethpandaops/ethereum-genesis-generator:6.0.2
COPY --from=egg-newer /apps/validator-mapping /apps/validator-mapping
# 6.0.2's eth2-val-tools calls the builder credential type 0x03 and emits
# 0300... credentials; the prefix is signed over, so nothing downstream can fix
# it. 6.2.0 emits 0xb0. Only the builder deposits use this binary -- validator
# entries stay on 6.0.2, whose derivation is identical.
COPY --from=egg-newer /usr/local/bin/eth2-val-tools /usr/local/bin/eth2-val-tools-620

# envsubst turns an unset variable into the empty string, so every key
# patch-generator.sh writes as $VAR needs a default here. extra_env wins: the
# entrypoint sources /defaults/defaults.env before /config/values.env.
ENV SLOTS_PER_ROUND=8
ENV AVAILABLE_ATTESTATION_DUE_BPS_HEZE=2500
ENV TARGET_COMMITTEE_SIZE=3000
ENV ATTESTATION_SUBNET_COUNT=1
ENV SUBNETS_PER_NODE=2

# Builder registry seeding, off by default so a baseline genesis is unchanged.
# BUILDER_EXEC_ADDR must be a real address even at BUILDER_COUNT=0: the
# entrypoint rewrites WITHDRAWAL_ADDRESS to "null" for 0x00 withdrawals, so
# there is nothing else to fall back to. This is the package's own default
# withdrawal address, prefunded in the EL genesis.
ENV BUILDER_COUNT=0
ENV BUILDER_KEY_INDEX=""
ENV BUILDER_DEPOSIT_GWEI=1000000000000
ENV BUILDER_EXEC_ADDR=0x8943545177806ED17B9F23F0a21ee5948eCaa776

COPY prysmctl /usr/local/bin/prysmctl
COPY prysm-genesis-state.sh /usr/local/bin/prysm-genesis-state.sh
COPY patch-generator.sh /tmp/patch-generator.sh
RUN /tmp/patch-generator.sh
