# ethereum-genesis-generator for the decoupled fork. The patches live in a
# real branch now: github.com/sukunrt/ethereum-genesis-generator, branch
# `decoupled`, forked from upstream v6.2.1 -- one commit per patch, diffable
# against upstream:
#
#  1. config-example/cl/config.yaml: SLOTS_PER_ROUND,
#     AVAILABLE_ATTESTATION_DUE_BPS_HEZE, TARGET_COMMITTEE_SIZE added;
#     SUBNETS_PER_NODE / ATTESTATION_SUBNET_COUNT are env vars.
#  2. apps/el-gen/generate_genesis.sh: Heze is CL-only, no bogota in the EL.
#  3. defaults/defaults.env: envsubst defaults for the above + BUILDER_*.
#  4. apps/prysm-genesis-state.sh installed over eth-genesis-state-generator.
#
# build-images.sh builds the branch into decoupled-genesis-gen-base directly
# from the git URL (docker builds git contexts), pinned to the rev below.
# Only prysmctl still comes from this tree: it generates the Heze genesis
# state, so it must match the fork's consensus types exactly.
FROM decoupled-genesis-gen-base
LABEL genesis-gen.patch=decoupled@a40dc31d75b9362cfb62b252e346ec7d19ceefab
COPY prysmctl /usr/local/bin/prysmctl
