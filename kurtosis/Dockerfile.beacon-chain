# Prysm beacon-chain for kurtosis, over a statically linked `go build` binary.
#
# The build context is produced by build-images.sh; it holds nothing but the
# binaries. The binary path must be /beacon-chain: ethereum-package's prysm
# launcher hardcodes it (src/cl/prysm/prysm_launcher.star,
# PRYSM_ENTRYPOINT_COMMAND) and runs it through `sh -c`, so the image also
# needs a shell.
#
# The package reads the ENR from /eth/v1/node/identity the moment the HTTP
# port opens and does not retry; the identity endpoint now waits for the ENR
# in-process, so no readiness gate is needed here.
FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY beacon-chain /beacon-chain

ENTRYPOINT ["/beacon-chain"]
