# Prysm validator client for kurtosis. See Dockerfile.beacon-chain.
#
# ethereum-package's prysm VC launcher (src/vc/prysm.star) does not override
# the entrypoint, so the binary has to be the image ENTRYPOINT, and it lives
# at /validator to match the upstream offchainlabs image.
#
# No shim: since ethereum-package 04988b4 a 1:1 Prysm BN/VC pair defaults to
# gRPC (--beacon-rpc-provider). The REST client now supports the fork's duties,
# available attestations included, so either path works; add
# --enable-beacon-rest-api to vc_extra_params to select REST.
FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY validator /validator

ENTRYPOINT ["/validator"]
