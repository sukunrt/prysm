# buildoor for the decoupled fork. The patches live in the branch now:
# github.com/sukunrt/buildoor, branch `decoupled`, forked from upstream
# 8ea9e96f. One commit per patch:
#
#  1. pkg/chain/engineversion.go: Heze -> Amsterdam in EngineVersion only
#     (Heze is CL-only here, the EL stays on Amsterdam/V4; stock Bogota/V5
#     got -32601 from geth and killed run 13). BeaconVersion untouched.
#  2. pkg/chain/constants.go: IsBuilderActive also accepts DepositEpoch == 0
#     (genesis-seeded builders; at genesis 0 < 0 fails and the gate holds).
#  3. pkg/p2p_bidder/service.go: same DepositEpoch == 0 exemption in
#     computeRegistrationState's inline copy -- both gates must open.
#  Plus a committed pkg/webui/static/index.html stub so `make build` skips
#  the npm toolchain and //go:embed compiles.
#
# Read the "state=" field on buildoor's "Builder found in beacon state" line:
# "registered" is the only value that means the bid loop will run.

FROM golang:1.26-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libc6-dev git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Tip of sukunrt/buildoor `decoupled` (4 patch commits on upstream 8ea9e96f).
ARG BUILDOOR_REV=3fa1866dcacc0894fa41bca34cffd33cfcebfc8b
RUN git clone -b decoupled https://github.com/sukunrt/buildoor.git . \
    && git checkout "$BUILDOOR_REV"

RUN make build VERSION="$BUILDOOR_REV" RELEASE=decoupled

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -r -s /bin/false buildoor
USER buildoor

COPY --from=builder /app/bin/buildoor /usr/local/bin/buildoor

# Upstream ships no labels, so the run has no way to tell one buildoor image
# from another. Ours records what it is.
LABEL buildoor.rev=8ea9e96fdd973d1b1cb9c88410ee0c92423c337a
LABEL buildoor.patch=decoupled@3fa1866dcacc0894fa41bca34cffd33cfcebfc8b

EXPOSE 9000

ENTRYPOINT ["buildoor"]
CMD ["run"]
